# syntax=docker/dockerfile:1
# ============================================================
# chameleon 前端镜像：Node 构建 + nginx 托管 + /api 反向代理
# 构建：docker build -f Dockerfile.web -t chameleon-web:latest .
# ============================================================

# ---------- 构建阶段 ----------
FROM node:20-alpine AS builder
WORKDIR /web

COPY snowy-admin-web/package.json snowy-admin-web/package-lock.json ./
RUN npm ci

COPY snowy-admin-web/ ./
# .env.production 中 VITE_API_BASEURL 留空，前端走相对路径 /api，由 nginx 转发
RUN npm run build

# ---------- 运行阶段 ----------
FROM nginx:1.27-alpine

ENV BACKEND_HOST=chameleon-web-app \
    BACKEND_PORT=82

COPY deploy/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=builder /web/dist /usr/share/nginx/html

EXPOSE 80
