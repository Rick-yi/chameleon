<?xml version="1.0" encoding="utf-8"?>
<!-- 内网/自建服务可能仍是 http，调试期放开明文；生产建议只留 https -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
