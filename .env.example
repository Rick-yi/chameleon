# ============================================================
# 生产环境变量示例
# 用法：复制为 .env，填入真实值；.env 已在 .gitignore 中排除
# 对应配置：snowy-web-app/src/main/resources/application-prod.yml
# ============================================================

# ---- 必填：数据库 ----
# 强烈建议不要使用 12345678 之类的默认值
MYSQL_ROOT_PASSWORD=change-me-strong-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=chameleon
MYSQL_USER=root
# 若账号与 root 不同，单独指定（留空则复用上面的账号口令）
MYSQL_PWD=

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=1
REDIS_PWD=

# ---- 服务 ----
SERVER_PORT=82
LOG_PATH=./logs

# ---- 可选：初始化开关（scripts/db-init.sh）----
# 跳演示数据，生产建议 1
SKIP_DEMO=1
